{
  "autoMemoryEnabled": false,
  "mcpServers": {
    "gitnexus": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "siss-mcp-gitnexus"
      ]
    }
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "exa@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/pre_tool_use_verification_gate.sh",
            "statusMessage": "Verifying correctness gate..."
          }
        ]
      }
    ],
    "PostToolUse": [],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/andriileukhin/Documents/SovereignNexus/claude-alert.sh",
            "timeout": 5,
            "statusMessage": "Alert: your input needed"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/andriileukhin/Documents/SovereignNexus/claude-alert.sh",
            "statusMessage": "Alert: Claude stopped for input"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/andriileukhin/Documents/SovereignNexus/claude-alert.sh",
            "statusMessage": "Alert: Task completed"
          }
        ]
      }
    ]
  },
  "dispatcher": {
    "enabled": false,
    "taskQueueLocation": ".claude/dispatcher/task_queue.json",
    "agentContextLocation": ".claude/dispatcher/agent_context",
    "maxConcurrentAgents": 5,
    "mergeStrategy": "sequential",
    "conflictResolutionRules": {
      "fileConflict": "abort_and_alert",
      "symrefConflict": "manual_resolution",
      "metadataConflict": "merge_dispatcher_metadata",
      "lockTimeout": 30000
    },
    "hookExecutionOrder": [
      "PreToolUse (dispatcher gate check)",
      "PreToolUse (security gate)",
      "PreToolUse (verification gate)",
      "Tool execution",
      "PostToolUse (audit logging)",
      "PostToolUse (dispatcher progress tracking)",
      "Automatic merge check"
    ],
    "stateFile": ".claude/dispatcher/dispatcher_state.json",
    "agentChannels": {
      "reportInterval": 1000,
      "queueCheckInterval": 500,
      "mergeCheckInterval": 5000
    }
  }
}
