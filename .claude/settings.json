{
  "autoMemoryEnabled": false,
  "mcpServers": {
    "gitnexus": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "siss-mcp-gitnexus"
      ]
    }
  },
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "exa@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/pre_tool_use_gate.js"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/pre_tool_use_verification_gate.sh",
            "statusMessage": "Verifying correctness gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/post_tool_use_logger.js"
          }
        ]
      }
    ]
  }
}
