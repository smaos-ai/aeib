# SOVEREIGN OS — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env and customize for your deployment
# Never commit actual credentials to version control

# ═════════════════════════════════════════════════════════════
# VISION API (Python FastAPI)
# ═════════════════════════════════════════════════════════════

PYTHON_ENV=production
VISION_API_HOST=0.0.0.0
VISION_API_PORT=8000
VISION_API_WORKERS=4
VISION_API_LOG_LEVEL=info

# ═════════════════════════════════════════════════════════════
# DASHBOARD (Next.js)
# ═════════════════════════════════════════════════════════════

NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# ═════════════════════════════════════════════════════════════
# OLLAMA (Local LLM)
# ═════════════════════════════════════════════════════════════

OLLAMA_HOST=0.0.0.0:11434
OLLAMA_NUM_GPU=0
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_TEMPERATURE=0.7
OLLAMA_NUM_CONTEXT=4096

# ═════════════════════════════════════════════════════════════
# VAULT (Secret Management)
# ═════════════════════════════════════════════════════════════

VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=sovereign-dev-token
VAULT_SKIP_VERIFY=false

# GitHub Actions OIDC
VAULT_OIDC_AUDIENCE=https://vault.example.com
VAULT_OIDC_ROLE=github-actions
GITHUB_ACTIONS_OIDC_TOKEN_REQUEST_URL=${GITHUB_TOKEN_REQUEST_URL}

# ═════════════════════════════════════════════════════════════
# PROMETHEUS (Metrics)
# ═════════════════════════════════════════════════════════════

PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_SCRAPE_INTERVAL=15s

# ═════════════════════════════════════════════════════════════
# JAEGER (Distributed Tracing)
# ═════════════════════════════════════════════════════════════

JAEGER_HOST=0.0.0.0
JAEGER_QUERY_PORT=16686
JAEGER_COLLECTOR_OTLP_PORT=4317
JAEGER_SPAN_STORAGE_TYPE=badger
JAEGER_COLLECTOR_OTLP_ENABLED=true

# ═════════════════════════════════════════════════════════════
# OPENTELEMETRY (Tracing Configuration)
# ═════════════════════════════════════════════════════════════

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sovereign-nexus
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true

# ═════════════════════════════════════════════════════════════
# DEPLOYMENT & MONITORING
# ═════════════════════════════════════════════════════════════

DEPLOYMENT_ENV=production
HEALTH_CHECK_INTERVAL=60
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3
ROLLBACK_THRESHOLD=2  # Trigger rollback if 2+ services fail

# ═════════════════════════════════════════════════════════════
# SECURITY & COMPLIANCE
# ═════════════════════════════════════════════════════════════

TZ=UTC
LOG_LEVEL=info
AUDIT_LOG_PATH=/var/log/sovereign/audit.log
STATE_SNAPSHOT_PATH=/var/lib/sovereign/state.json
EXEC_LOG_PATH=/Users/andriileukhin/Documents/SovereignNexus/EXEC_LOG.json

# ═════════════════════════════════════════════════════════════
# PERFORMANCE TUNING
# ═════════════════════════════════════════════════════════════

# Vision API
VISION_API_TIMEOUT=30
VISION_API_MAX_CONNECTIONS=100

# Dashboard
NEXT_TELEMETRY_DISABLED=1
NODE_MAX_CONNECTIONS=1000

# Ollama
OLLAMA_REQUEST_TIMEOUT=60
OLLAMA_INFERENCE_TIMEOUT=30

# Database (future)
DATABASE_POOL_SIZE=10
DATABASE_POOL_TIMEOUT=30

# ═════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═════════════════════════════════════════════════════════════

FEATURE_WEBSOCKET_BROADCAST=true
FEATURE_MERKLE_AUDIT=true
FEATURE_AUTO_ROLLBACK=true
FEATURE_PROMETHEUS_METRICS=true
FEATURE_JAEGER_TRACING=true
