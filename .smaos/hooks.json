{
  "hooks": {
    "SessionEnd": {
      "command": "python3 .smaos/scripts/sync_kanban.py --mode session_end",
      "timeout": 30,
      "fail_action": "warn_only"
    },
    "PostCompact": {
      "command": "python3 .smaos/scripts/sync_kanban.py --mode compact",
      "timeout": 15,
      "fail_action": "warn_only"
    }
  }
}
