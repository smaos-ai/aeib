# SovereignNexus Pre-Production Dockerfile
# Multi-stage build for SMAOS Phase 1 (L1-L8 harness)
# Optimized for RTX 4060 8GB + edge deployment + cloud scalability

ARG RUST_VERSION=1.75
ARG UBUNTU_VERSION=22.04

# ============================================================================
# STAGE 1: Builder — Compile Rust harness (6000+ lines, 8 layers)
# ============================================================================
FROM rust:${RUST_VERSION}-slim-jammy as builder

RUN apt-get update && apt-get install -y \
    pkg-config \
    libpq-dev \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy workspace manifest
COPY Cargo.* ./
COPY crates ./crates

# Build release binary (optimized, ~30-40 MB final binary)
# Enable LTO for production
RUN RUSTFLAGS="-C target-cpu=native -C lto=thin" \
    cargo build --release --workspace --bins 2>&1 | head -100

# Extract binaries
RUN mkdir -p /artifacts && \
    find target/release -maxdepth 1 -type f -executable ! -name "*.d" \
    -exec cp {} /artifacts/ \; && \
    cp -r crates/*/migrations /artifacts/ 2>/dev/null || true

# ============================================================================
# STAGE 2: Runtime — Production image (minimal footprint)
# ============================================================================
FROM ubuntu:${UBUNTU_VERSION}

# Install runtime dependencies only (not dev tools)
RUN apt-get update && apt-get install -y \
    libpq5 \
    ca-certificates \
    curl \
    postgresql-client \
    psmisc \
    && rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 1000 smaos

WORKDIR /app

# Copy compiled binaries from builder
COPY --from=builder /artifacts /app/bin
COPY --from=builder /artifacts/migrations ./migrations

# Configuration & environment
ENV PATH="/app/bin:${PATH}" \
    RUST_LOG=info,l4=debug,l7=debug,l8=debug \
    LOG_DIR=/var/log/smaos \
    CHECKPOINT_DIR=/var/lib/smaos/checkpoints

# Create required directories
RUN mkdir -p $LOG_DIR $CHECKPOINT_DIR && \
    chown -R smaos:smaos /app $LOG_DIR $CHECKPOINT_DIR && \
    chmod 0755 /app/bin/*

# Security: Drop capabilities
USER smaos

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Expose main API port
EXPOSE 8080

# Entrypoint: Run migrations + start harness
COPY --chown=smaos:smaos <<'ENTRYPOINT' /app/entrypoint.sh
#!/bin/bash
set -e

# Wait for PostgreSQL
until pg_isready -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U postgres; do
    echo "Waiting for PostgreSQL..."
    sleep 2
done

# Run migrations if needed
if [ -d /app/migrations ]; then
    sqlx migrate run --database-url "${DATABASE_URL}" || true
fi

# Start SMAOS harness
exec /app/bin/smaos-harness
ENTRYPOINT

RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]

# Metadata
LABEL maintainer="Andrei Leukhin <andrejlo123@gmail.com>" \
      version="1.0.0" \
      description="SovereignNexus SMAOS Phase 1 — EU AI Act governance harness" \
      org.opencontainers.image.source="https://github.com/sovreignnexus/smaos"
