    },
    {
      "id": "tampered-signature",
      "receipt": "tampered-signature/receipt.json",
      "publicKey": "tampered-signature/public.pem",
      "expectedExitCode": 2,
      "description": "Single byte corruption in Ed25519 signature"
    },
    {
      "id": "wrong-key",
      "receipt": "wrong-key/receipt.json",
      "publicKey": "wrong-key/public.pem",
      "expectedExitCode": 2,
      "description": "Public key does not match signing private key"
    },
    {
      "id": "unknown-keyid",
      "receipt": "unknown-keyid/receipt.json",
