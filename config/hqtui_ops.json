{
  "telemetry_refresh_fps": 15,
  "ssh_optimized": true,
  "zero_dependencies": true,
  "description": "HQTUI 15fps terminal telemetry over SSH without Electron",
  "active_panels": [
    {
      "id": "hardware_gauges",
      "metrics": ["cpu_load", "vram_alloc", "tokens_sec", "nvme_temp"],
      "update_interval_ms": 66,
      "layout": "horizontal"
    },
    {
      "id": "egress_monitor",
      "metrics": ["inbound_kbps", "outbound_kbps", "firewall_drops", "approved_destinations"],
      "update_interval_ms": 100,
      "layout": "vertical"
    },
    {
      "id": "live_receipt_stream",
      "source": "/var/log/smaos/agentacct_stream.jsonl",
      "follow_tail": true,
      "max_lines": 50,
      "update_interval_ms": 200
    },
    {
      "id": "gate_status",
      "triggers": ["ANNEX_III_PAUSE", "PII_BLOCKED", "HUMAN_VETO", "EGRESS_VIOLATION"],
      "colors": {
        "ANNEX_III_PAUSE": "yellow",
        "PII_BLOCKED": "red",
        "HUMAN_VETO": "cyan",
        "EGRESS_VIOLATION": "red"
      },
      "update_interval_ms": 50
    }
  ],
  "ssh_streaming": {
    "protocol": "SSE (Server-Sent Events) over HTTPS",
    "charset": "UTF-8",
    "ansi_colors": true,
    "width_chars": 120,
    "height_lines": 40
  }
}
