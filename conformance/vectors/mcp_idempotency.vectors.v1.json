{
  "conformance_suite": "mcp_idempotency.vectors.v1",
  "target_spec": "AEIB Idempotent MCP Specification v1.0",
  "vectors": [
    {
      "vector_id": "mcp-vec-001",
      "name": "fresh_call_success",
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 10000},
          "idempotency_key": "k-001",
          "caid": "sha256:1111"
        }
      },
      "expected_status": 200,
      "expected_state": "CONFIRMED"
    },
    {
      "vector_id": "mcp-vec-002",
      "name": "replay_within_window_returns_cached",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 10000},
            "idempotency_key": "k-002",
            "caid": "sha256:2222"
          }
        },
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 10000},
            "idempotency_key": "k-002",
            "caid": "sha256:2222"
          }
        }
      ],
      "expected_final_status": 200,
      "expected_meta_replay": true
    },
    {
      "vector_id": "mcp-vec-003",
      "name": "caid_collision_different_key_same_intent",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 10000},
            "idempotency_key": "k-003a",
            "caid": "sha256:3333"
          }
        },
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 10000},
            "idempotency_key": "k-003b",
            "caid": "sha256:3333"
          }
        }
      ],
      "expected_final_status": 200,
      "expected_meta_replay": true
    },
    {
      "vector_id": "mcp-vec-004",
      "name": "timeout_504_latches_indeterminate",
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 15000},
          "idempotency_key": "k-004",
          "caid": "sha256:4444"
        }
      },
      "simulate_upstream": "TIMEOUT",
      "expected_status": 504,
      "expected_error": "ERR_EFFECT_INDETERMINATE_LATCHED"
    },
    {
      "vector_id": "mcp-vec-005",
      "name": "blind_retry_blocked_under_indeterminate",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 15000},
            "idempotency_key": "k-005",
            "caid": "sha256:5555"
          },
          "simulate_upstream": "TIMEOUT"
        },
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 15000},
            "idempotency_key": "k-005",
            "caid": "sha256:5555"
          }
        }
      ],
      "expected_final_status": 400,
      "expected_error": "HALT_BLIND_RETRY_PROHIBITED_UNDER_UNCERTAINTY"
    },
    {
      "vector_id": "mcp-vec-006",
      "name": "reconciliation_status_probe_resolves_confirmed",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 15000},
            "idempotency_key": "k-006",
            "caid": "sha256:6666"
          },
          "simulate_upstream": "TIMEOUT"
        },
        {
          "method": "tools/status",
          "params": {"idempotency_key": "k-006"},
          "simulate_remote_status": {"state": "CONFIRMED"}
        }
      ],
      "expected_final_state": "CONFIRMED"
    },
    {
      "vector_id": "mcp-vec-007",
      "name": "reconciliation_status_probe_resolves_refuted",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 15000},
            "idempotency_key": "k-007",
            "caid": "sha256:7777"
          },
          "simulate_upstream": "TIMEOUT"
        },
        {
          "method": "tools/status",
          "params": {"idempotency_key": "k-007"},
          "simulate_remote_status": {"state": "REFUTED"}
        }
      ],
      "expected_final_state": "REFUTED"
    },
    {
      "vector_id": "mcp-vec-008",
      "name": "reconciliation_unsupported_endpoint_retains_indeterminate",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 15000},
            "idempotency_key": "k-008",
            "caid": "sha256:8888"
          },
          "simulate_upstream": "TIMEOUT"
        },
        {
          "method": "tools/status",
          "params": {"idempotency_key": "k-008"},
          "simulate_remote_status": {"error": "METHOD_NOT_FOUND"}
        }
      ],
      "expected_final_state": "EFFECT_INDETERMINATE"
    },
    {
      "vector_id": "mcp-vec-009",
      "name": "ttl_expiry_allows_new_intent_with_new_epoch",
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 1000},
          "idempotency_key": "k-009",
          "policy_epoch": "epoch-2026-Q4"
        }
      },
      "simulate_expired_record_with_epoch": "epoch-2026-Q3",
      "expected_status": 200,
      "expected_state": "CONFIRMED"
    },
    {
      "vector_id": "mcp-vec-010",
      "name": "server_crash_recovery_from_wal",
      "description": "Simulates proxy restart; SQLite WAL preserves in-flight indeterminates.",
      "simulate_proxy_restart": true,
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 2000},
          "idempotency_key": "k-010",
          "caid": "sha256:1010"
        }
      },
      "expected_status": 504,
      "expected_state": "EFFECT_INDETERMINATE"
    },
    {
      "vector_id": "mcp-vec-011",
      "name": "missing_idempotency_key_rejection",
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 5000}
        }
      },
      "expected_status": 200,
      "expected_error_code": -32602
    },
    {
      "vector_id": "mcp-vec-012",
      "name": "upstream_500_error_latches_indeterminate",
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 5000},
          "idempotency_key": "k-012"
        }
      },
      "simulate_upstream_error": {"code": -32000, "message": "Internal Server Error"},
      "expected_final_state": "EFFECT_INDETERMINATE"
    },
    {
      "vector_id": "mcp-vec-013",
      "name": "upstream_400_client_error_marks_refuted",
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 5000},
          "idempotency_key": "k-013"
        }
      },
      "simulate_upstream_error": {"code": 400, "message": "Bad Request"},
      "expected_final_state": "REFUTED"
    },
    {
      "vector_id": "mcp-vec-014",
      "name": "malformed_json_rpc_frame_rejection",
      "input": {
        "method": "tools/call",
        "params": "INVALID_PARAM_TYPE"
      },
      "expected_status": 200,
      "expected_error_code": -32602
    },
    {
      "vector_id": "mcp-vec-015",
      "name": "concurrent_thundering_herd_serialization",
      "description": "Fires 10 parallel requests with identical idempotency_key; exactly 1 hits upstream.",
      "simulate_concurrent_threads": 10,
      "idempotency_key": "k-thundering-herd",
      "expected_upstream_invocation_count": 1
    },
    {
      "vector_id": "mcp-vec-016",
      "name": "different_tools_same_caid_isolation",
      "description": "Ensures CAID hashing namespaces tool names so tool A and tool B do not collide.",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "tool.alpha",
            "arguments": {"x": 1},
            "idempotency_key": "k-016a",
            "caid": "sha256:same"
          }
        },
        {
          "method": "tools/call",
          "params": {
            "name": "tool.beta",
            "arguments": {"x": 1},
            "idempotency_key": "k-016b",
            "caid": "sha256:same"
          }
        }
      ],
      "expected_upstream_invocation_count": 2
    },
    {
      "vector_id": "mcp-vec-017",
      "name": "unsupported_method_pass_through",
      "input": {
        "method": "tools/list",
        "params": {}
      },
      "expected_status": 200,
      "expected_passthrough": true
    },
    {
      "vector_id": "mcp-vec-018",
      "name": "status_check_missing_key_error",
      "input": {
        "method": "tools/status",
        "params": {}
      },
      "expected_error_code": -32602
    },
    {
      "vector_id": "mcp-vec-019",
      "name": "status_check_nonexistent_key",
      "input": {
        "method": "tools/status",
        "params": {"idempotency_key": "ghost-key"}
      },
      "expected_remote_state": "NOT_FOUND"
    },
    {
      "vector_id": "mcp-vec-020",
      "name": "epoch_rotation_allows_retries_after_ttl",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount": 100},
            "idempotency_key": "k-020",
            "policy_epoch": "2026-Q3"
          }
        },
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount": 100},
            "idempotency_key": "k-020",
            "policy_epoch": "2026-Q4"
          }
        }
      ],
      "expected_final_status": 200,
      "expected_disposition": "CONFIRMED"
    },
    {
      "vector_id": "mcp-vec-021",
      "name": "mcp_tool_level_is_error_requires_reconciliation",
      "description": "MCP tool-level isError: true within JSON-RPC 200 does not mark CONFIRMED; routes to EFFECT_INDETERMINATE.",
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 15000},
          "idempotency_key": "k-021",
          "caid": "sha256:2121"
        }
      },
      "simulate_tool_is_error": {
        "isError": true,
        "content": [{"type": "text", "text": "Upstream temporary lock"}]
      },
      "expected_final_state": "EFFECT_INDETERMINATE"
    },
    {
      "vector_id": "mcp-vec-022",
      "name": "caid_operation_identity_conflict_escalation",
      "description": "Same CAID with different operation_id triggers conflict resolution escalation.",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 25000},
            "idempotency_key": "k-022a",
            "operation_id": "op-022-alpha",
            "caid": "sha256:2222"
          },
          "simulate_upstream": "TIMEOUT"
        },
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 25000},
            "idempotency_key": "k-022b",
            "operation_id": "op-022-beta",
            "caid": "sha256:2222"
          }
        }
      ],
      "expected_final_status": 409,
      "expected_error": "HALT_CAID_OPERATION_IDENTITY_CONFLICT"
    },
    {
      "vector_id": "mcp-vec-023",
      "name": "ttl_expiry_preserves_indeterminate_state_escalation",
      "description": "TTL expiry does not clear unresolved EFFECT_INDETERMINATE; transitions to UNRESOLVED_ESCALATED.",
      "simulate_expired_indeterminate": true,
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 30000},
          "idempotency_key": "k-023",
          "caid": "sha256:2323"
        }
      },
      "expected_final_state": "UNRESOLVED_ESCALATED",
      "expected_error": "OPERATION_UNRESOLVED_REQUIRES_RECONCILIATION"
    },
    {
      "vector_id": "mcp-vec-024",
      "name": "epoch_rotation_preserves_latched_uncertainty",
      "description": "Policy epoch rotation preserves prior latched indeterminate state without silent erasure.",
      "simulate_epoch_rotation_indeterminate": {
        "prior_epoch": "epoch-2026-Q3",
        "new_epoch": "epoch-2026-Q4"
      },
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 12000},
            "idempotency_key": "k-024",
            "policy_epoch": "epoch-2026-Q3"
          },
          "simulate_upstream": "TIMEOUT"
        },
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 12000},
            "idempotency_key": "k-024",
            "policy_epoch": "epoch-2026-Q4"
          }
        }
      ],
      "expected_error": "HALT_BLIND_RETRY_PROHIBITED_UNDER_UNCERTAINTY"
    },
    {
      "vector_id": "mcp-vec-025",
      "name": "upstream_idempotency_key_forwarding_stability",
      "description": "Upstream idempotency key forwarded is stable across proxy retries.",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 8000},
            "idempotency_key": "k-025-stable"
          },
          "simulate_upstream": "TIMEOUT"
        },
        {
          "method": "tools/status",
          "params": {
            "idempotency_key": "k-025-stable"
          },
          "simulate_remote_status": {"state": "CONFIRMED"}
        }
      ],
      "expected_forwarded_key": "k-025-stable"
    },
    {
      "vector_id": "mcp-vec-026",
      "name": "reconciliation_probe_contradiction_preserves_uncertainty",
      "description": "Contradictory probe response preserves uncertainty without blind resolution.",
      "sequence": [
        {
          "method": "tools/call",
          "params": {
            "name": "refund.create",
            "arguments": {"amount_minor": 16000},
            "idempotency_key": "k-026"
          },
          "simulate_upstream": "TIMEOUT"
        },
        {
          "method": "tools/status",
          "params": {"idempotency_key": "k-026"},
          "simulate_remote_status": {"state": "CONTRADICTORY_CONFLICT"}
        }
      ],
      "expected_final_state": "EFFECT_INDETERMINATE"
    },
    {
      "vector_id": "mcp-vec-027",
      "name": "disk_io_failure_fails_closed",
      "description": "SQLite I/O failure or read-only database fails closed without upstream dispatch.",
      "simulate_storage_io_error": true,
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 17000},
          "idempotency_key": "k-027"
        }
      },
      "expected_upstream_invocation_count": 0,
      "expected_error": "HALT_STORAGE_IO_FAILURE_FAILED_CLOSED"
    },
    {
      "vector_id": "mcp-vec-028",
      "name": "clock_skew_does_not_bypass_latch",
      "description": "Clock skew backwards does not bypass TTL, latch, or expiration checks.",
      "simulate_backward_clock_skew": true,
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 18000},
          "idempotency_key": "k-028"
        }
      },
      "expected_final_state": "EFFECT_INDETERMINATE"
    },
    {
      "vector_id": "mcp-vec-029",
      "name": "capability_expiration_blocks_dispatch",
      "description": "Expired capability token or timestamp blocks new dispatch before network call.",
      "input": {
        "method": "tools/call",
        "params": {
          "name": "refund.create",
          "arguments": {"amount_minor": 19000},
          "idempotency_key": "k-029",
          "expires_at": 1000
        }
      },
      "expected_upstream_invocation_count": 0,
      "expected_error": "HALT_CAPABILITY_EXPIRED"
    },
    {
      "vector_id": "mcp-vec-030",
      "name": "multiprocess_contention_serialized",
      "description": "Multi-process contention against same SQLite file is detected and serialized via BEGIN IMMEDIATE.",
      "simulate_multiprocess_stress": 8,
      "idempotency_key": "k-030-multi",
      "expected_upstream_invocation_count": 1
    }
  ]
}
