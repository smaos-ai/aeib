{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SovereignNexus/agentic-fabric/contracts/capability.v1.json",
  "title": "AEIB Canonical Capability Warrant (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_version",
    "capability_id",
    "issuer",
    "audience",
    "subject_id",
    "allowed_actions",
    "spending_limits",
    "allowed_export_dirs",
    "policy_epoch",
    "issued_at",
    "expires_at",
    "signature"
  ],
  "properties": {
    "capability_version": { "type": "string", "const": "1" },
    "capability_id": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "subject_id": { "type": "string", "minLength": 1 },
    "allowed_actions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "spending_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "max_single_minor", "max_sprint_minor"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "max_single_minor": { "type": "integer", "minimum": 1 },
        "max_sprint_minor": { "type": "integer", "minimum": 1 }
      }
    },
    "allowed_export_dirs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policy_epoch": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "integer", "minimum": 1 },
    "expires_at": { "type": "integer", "minimum": 1 },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": { "type": "string", "enum": ["Ed25519", "ML-DSA-65"] },
        "key_id": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}
