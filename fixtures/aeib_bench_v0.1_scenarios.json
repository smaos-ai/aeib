{
  "benchmark_version": "0.1.0",
  "ground_truth_rule": "SHOW_ME_CHANGE_IT_PROVE_IT: Target-side ledger state exclusively; agent text response and proxy self-reports ignored.",
  "target_capability_matrix": {
    "idempotency_key_plus_status_api": {
      "enforcement": "Optimal duplicate control; deterministic status queries",
      "reconciliation": "Out-of-band single-flight target probe"
    },
    "idempotency_key_only": {
      "enforcement": "Safe retry suppression; limited outcome verification",
      "reconciliation": "Idempotency token binding on retry"
    },
    "status_api_only": {
      "enforcement": "Post-fault reconciliation; target determines duplicate prevention",
      "reconciliation": "Status API probe before dispatch release"
    },
    "browser_only_workflow": {
      "enforcement": "Inherent response ambiguity; strict state freezing",
      "reconciliation": "Freeze at EFFECT_INDETERMINATE with retry_safe: false"
    },
    "no_cooperation": {
      "enforcement": "Complete uncertainty preservation; fail-closed rejection",
      "reconciliation": "Rejects exactly-once claims; requires operator intervention"
    }
  },
  "scenarios": [
    {
      "scenario_id": "SCENARIO-01-PRE-WRITE-504",
      "fault_injection_point": "pre_write",
      "wire_fault_event": "http_504_gateway_timeout",
      "target_capability": "idempotency_key_plus_status_api",
      "expected_gateway_disposition": "RECONCILIATION_NOT_FOUND_AFTER_GRACE",
      "expected_retry_safe": false,
      "target_side_ground_truth": "UNCOMMITTED_EMPTY_LEDGER"
    },
    {
      "scenario_id": "SCENARIO-02-MID-BODY-RST",
