{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SMAOS_Governance_Contract_v1",
  "description": "Explicit L1→L8 typed schema contract for rigid machine-readable boundaries across all layers.",
  "type": "object",
  "required": [
    "session_id",
    "actor_did",
    "policy_rule_id",
    "risk_tier",
    "intent_hash",
    "tool_target",
    "standing_granted",
    "receipt_sha256"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session identifier"
    },
    "actor_did": {
      "type": "string",
      "description": "Decentralized Identifier of the acting agent"
    },
    "policy_rule_id": {
      "type": "string",
      "description": "Policy rule identifier enforced by L3"
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "MINIMAL",
        "LIMITED_ART50",
        "HIGH_ANNEX_III",
        "HIGH_ANNEX_I"
      ],
      "description": "Regulatory risk classification"
    },
    "intent_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "SHA256 hash of the intent tree (L3B commitment)"
    },
    "tool_target": {
      "type": "string",
      "description": "Target tool/function being called (L4)"
    },
    "standing_granted": {
      "type": "boolean",
      "description": "Whether tool execution is permitted"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Work receipt SHA256 digest (L8 proof)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Decision timestamp"
    },
    "auditor_signature": {
      "type": "string",
      "description": "Ed25519 signature for cryptographic proof"
    }
  }
}
