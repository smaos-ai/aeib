// Prisma schema for SISS Dashboard
// Includes Creator Platform MVP with royalty tracking and settlements

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Creator Platform Models
model Creator {
  id                String      @id @default(uuid()) @db.Uuid
  name              String
  email             String      @unique
  wallet            String      @unique // Ethereum address
  stripe_customer_id String
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  royalties         Royalty[]
  referrals_given   Referral[]  @relation("referrer")
  referrals_received Referral[]  @relation("referred")
  email_campaigns   EmailCampaign[]

  @@index([email])
  @@index([wallet])
  @@map("creators")
}

model Royalty {
  id                String      @id @default(uuid()) @db.Uuid
  creator_id        String      @db.Uuid
  amount            Decimal     @db.Decimal(12, 2) // Gross amount
  fee_percentage    Decimal     @default(5.0) @db.Decimal(5, 2)
  net_amount        Decimal     @db.Decimal(12, 2) // Gross - fees
  timestamp         DateTime
  status            String      @default("pending") // pending, completed, failed
  webhook_event_id  String?     @unique // For idempotency
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  creator           Creator     @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([creator_id])
  @@index([status])
  @@index([timestamp])
  @@index([webhook_event_id])
  @@map("royalties")
}

model Settlement {
  id                String      @id @default(uuid()) @db.Uuid
  batch_id          String      @unique
  creator_ids       String[]    @db.Text // JSON array of creator IDs
  total_amount      Decimal     @db.Decimal(12, 2)
  tx_hash           String?     // Blockchain transaction hash
  status            String      @default("pending") // pending, processing, completed, failed
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt
  settled_at        DateTime?

  @@index([status])
  @@index([batch_id])
  @@map("settlements")
}

// Referral tracking for creator acquisition
model Referral {
  id                    String      @id @default(uuid()) @db.Uuid
  referrer_id           String      @db.Uuid
  referred_creator_id   String      @db.Uuid
  commission_tier       String      @default("tier_1") // tier_1 (20%), tier_2 (15%), tier_3 (10%)
  amount                Decimal     @db.Decimal(12, 2)
  status                String      @default("pending") // pending, active, inactive
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt

  referrer              Creator     @relation("referrer", fields: [referrer_id], references: [id], onDelete: Cascade)
  referred_creator      Creator     @relation("referred", fields: [referred_creator_id], references: [id], onDelete: Cascade)

  @@index([referrer_id])
  @@index([referred_creator_id])
  @@index([status])
  @@map("referrals")
}

// Email campaign tracking
model EmailCampaign {
  id                String      @id @default(uuid()) @db.Uuid
  creator_id        String      @db.Uuid
  sequence_day      Int         // Day in the 8-sequence campaign
  email_type        String      // welcome, getting_started, feature_highlight, success_story, etc.
  status            String      @default("scheduled") // scheduled, sent, failed, bounced
  sent_at           DateTime?
  opened_at         DateTime?
  clicked_at        DateTime?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  creator           Creator     @relation(fields: [creator_id], references: [id], onDelete: Cascade)

  @@index([creator_id])
  @@index([status])
  @@index([sequence_day])
  @@map("email_campaigns")
}

// Original Models (kept for backward compatibility)
model CodeRepository {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique
  url       String?
  description String?
  language  String?
  stars     Int?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  document  Document[]

  @@map("repository")
}

model Document {
  id            String      @id @default(uuid()) @db.Uuid
  repositoryId  String      @map("repository_id") @db.Uuid
  path          String      @db.VarChar(1000)
  type          String
  language      String?
  content       String      @db.Text
  ingestedAt    DateTime    @default(now()) @map("ingested_at")

  repository    CodeRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  chunk         Chunk[]

  @@index([repositoryId])
  @@index([path])
  @@map("document")
}

model Chunk {
  id           String      @id @default(uuid()) @db.Uuid
  documentId   String      @map("document_id") @db.Uuid
  chunkIndex   Int         @map("chunk_index")
  content      String      @db.Text
  tokenCount   Int         @map("token_count")

  document     Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("chunk")
}
